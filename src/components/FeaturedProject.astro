---
// FeaturedProject.astro
---

<section class="section section--sm featured-section">
  <div class="container">
    <div class="label" data-i18n="featured_label">Featured Project</div>

    <div class="featured-card card" style="margin-top: var(--space-6);">
      <div class="featured-card__top">
        <div>
          <div class="featured-card__project-label">Townteam</div>
          <h2 class="featured-card__title">Sales Dashboard</h2>
        </div>
        <div class="featured-tools">
          <span class="tag">Power BI</span>
          <span class="tag">Power Query</span>
          <span class="tag">Python</span>
          <span class="tag">Figma</span>
        </div>
      </div>

      <div class="featured-card__body">
        <p data-i18n="featured_context">A Casablanca retail store had 2024 sales data — but no visibility into what was actually happening.</p>
        <p data-i18n="featured_result">I cleaned the data, built a proper data model, and delivered a 3-page Power BI dashboard that helped them plan stock, staffing, and product decisions.</p>
      </div>

      <div class="featured-card__footer">
        <a href="/projects/townteam" class="featured-link" data-i18n="featured_link">Read the full case study →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-section {
    border-top: 1px solid var(--clr-border);
  }

  .featured-card {
    padding: var(--space-8);
    background: var(--clr-bg-card);
  }

  .featured-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .featured-card__project-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-accent);
    margin-bottom: var(--space-1);
  }

  .featured-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--clr-text);
  }

  .featured-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .featured-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--clr-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 580px;
  }

  .featured-card__footer {
    border-top: 1px solid var(--clr-border);
    padding-top: var(--space-4);
  }

  .featured-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-accent);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .featured-link:hover {
    opacity: 0.8;
    text-decoration: none;
  }
</style>
