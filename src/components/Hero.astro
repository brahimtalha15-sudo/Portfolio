---
// Hero.astro
---

<section class="hero section">
  <div class="container">
    <div class="hero__inner">
      <div class="hero__badge label" data-i18n="hero_title">Data Analyst</div>
      <h1 class="hero__name">Brahim Talha</h1>
      <p class="hero__value" data-i18n="hero_value">I turn messy business data into clear decisions.</p>
      <div class="hero__subs">
        <p data-i18n="hero_sub1">I work with companies to understand what their data is actually saying.</p>
        <p data-i18n="hero_sub2">From raw exports to visual dashboards — structured, readable, actionable.</p>
      </div>
      <div class="hero__ctas">
        <a href="/projects" class="btn btn--primary" data-i18n="hero_cta_projects">View Projects</a>
        <a href="/#contact" class="btn btn--outline" data-i18n="hero_cta_contact">Contact</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-20);
    border-bottom: 1px solid var(--clr-border);
  }

  .hero__inner {
    max-width: 600px;
  }

  .hero__badge {
    margin-bottom: var(--space-4);
    display: inline-block;
  }

  .hero__name {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--clr-text);
    margin-bottom: var(--space-6);
  }

  .hero__value {
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    font-weight: 600;
    color: var(--clr-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: var(--space-4);
  }

  .hero__subs {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--clr-text-muted);
    font-size: var(--text-base);
    margin-bottom: var(--space-8);
    max-width: 520px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 480px) {
    .hero {
      padding-block: var(--space-16) var(--space-12);
    }
    .hero__ctas {
      flex-direction: column;
    }
    .btn {
      text-align: center;
      justify-content: center;
    }
  }
</style>
