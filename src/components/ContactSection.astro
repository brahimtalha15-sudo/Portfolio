---
// ContactSection.astro
---

<section id="contact" class="section section--sm contact-section">
  <div class="container">
    <div class="label" data-i18n="contact_label">Contact</div>
    <h2 class="section-title mt-3" data-i18n="contact_title">Let's talk</h2>
    <p class="section-subtitle contact-desc" data-i18n="contact_desc">
      Have a project in mind or just want to connect? I'm open to new
      opportunities.
    </p>

    <div class="contact-links">
      <a
        href="mailto:brahimtalha15@gmail.com"
        class="btn btn--primary contact-btn"
        id="email-link"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="1" y="3" width="14" height="10" rx="1"></rect><polyline
            points="1 3 8 9 15 3"></polyline></svg
        >
        <span data-i18n="contact_email">Send an email</span>
      </a>
      <a
        href="https://www.linkedin.com/in/brahim-talha"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline contact-btn"
        id="linkedin-link"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M20.447 20.452H17.21v-5.569c0-1.328-.024-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.985V9h3.102v1.561h.046c.432-.82 1.487-1.684 3.059-1.684 3.273 0 3.876 2.154 3.876 4.959v6.616zM5.337 7.433a1.8 1.8 0 01-1.8-1.8c0-.994.807-1.8 1.8-1.8 1 0 1.8.806 1.8 1.8 0 .993-.8 1.8-1.8 1.8zm1.555 13.019H3.783V9h3.109v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path></svg
        >
        <span data-i18n="contact_linkedin">LinkedIn</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--clr-border);
  }

  .mt-3 {
    margin-top: 0.75rem;
  }

  .contact-desc {
    margin-top: var(--space-3);
    max-width: 440px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .contact-btn {
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .contact-links {
      flex-direction: column;
    }
  }
</style>
