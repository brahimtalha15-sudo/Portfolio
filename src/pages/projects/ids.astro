---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

const project = projects.find(p => p.slug === 'ids')!;
const lang = 'en';
const p = project;
---

<Layout
  title="School Management System (IDS) — Brahim Talha"
  description="Designed and deployed a structured PostgreSQL database for a school management system, built as part of an AI certification team project."
>
  <Navbar />
  <main>
    <article class="case-study">
      <div class="container">

        <a href="/projects" class="back-link" data-i18n="detail_back">← Back to projects</a>

        <header class="case-header">
          <div class="case-header__meta">
            <span class="label">IDS</span>
            <span class="badge badge--completed">
              <span class="badge-dot"></span>
              <span data-i18n="status_completed">Completed</span>
            </span>
          </div>
          <h1 class="case-title" data-i18n-key="title">{p.title[lang]}</h1>
          <p class="case-tagline" data-i18n-key="tagline">{p.tagline[lang]}</p>

          <div class="case-tools">
            <span class="meta-label" data-i18n="detail_tools">Tools</span>
            <div class="tools-list">
              {p.tools.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </header>

        <div class="case-sections">
          <section class="case-section">
            <h2 class="case-section__title" data-i18n="detail_context">Context</h2>
            <p class="case-section__body" data-i18n-key="context">{p.detail.context[lang]}</p>
          </section>
          <section class="case-section">
            <h2 class="case-section__title" data-i18n="detail_problem">Problem</h2>
            <p class="case-section__body" data-i18n-key="problem">{p.detail.problem[lang]}</p>
          </section>
          <section class="case-section">
            <h2 class="case-section__title" data-i18n="detail_approach">Approach</h2>
            <p class="case-section__body" data-i18n-key="approach">{p.detail.approach[lang]}</p>
          </section>
          <section class="case-section">
            <h2 class="case-section__title" data-i18n="detail_decisions">Key Decisions</h2>
            <p class="case-section__body" data-i18n-key="keyDecisions">{p.detail.keyDecisions[lang]}</p>
          </section>
          <section class="case-section outcome-section">
            <h2 class="case-section__title" data-i18n="detail_outcome">Outcome & Insights</h2>
            <p class="case-section__body" data-i18n-key="outcome">{p.detail.outcome[lang]}</p>
          </section>
          <section class="case-section learned-section">
            <h2 class="case-section__title" data-i18n="detail_learned">What I Learned</h2>
            <p class="case-section__body" data-i18n-key="learned">{p.detail.learned[lang]}</p>
          </section>
        </div>

        <div class="case-footer">
          <a href="/projects" class="btn btn--outline" data-i18n="detail_back">← Back to projects</a>
        </div>

      </div>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  import { projects } from '../../data/projects';
  const project = projects.find(p => p.slug === 'ids')!;
  const fields: Record<string, keyof typeof project.detail> = {
    context: 'context', problem: 'problem', approach: 'approach',
    keyDecisions: 'keyDecisions', outcome: 'outcome', learned: 'learned',
  };
  function applyProjectLang(lang: 'en' | 'fr') {
    const titleEl = document.querySelector('[data-i18n-key="title"]');
    const taglineEl = document.querySelector('[data-i18n-key="tagline"]');
    if (titleEl) titleEl.textContent = project.title[lang];
    if (taglineEl) taglineEl.textContent = project.tagline[lang];
    for (const [key, field] of Object.entries(fields)) {
      const el = document.querySelector(`[data-i18n-key="${key}"]`);
      if (el) el.textContent = (project.detail[field] as any)[lang];
    }
  }
  document.addEventListener('DOMContentLoaded', () => {
    applyProjectLang((localStorage.getItem('lang') || 'en') as 'en' | 'fr');
  });
  document.querySelectorAll('[data-lang-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      applyProjectLang(btn.getAttribute('data-lang-btn') as 'en' | 'fr');
    });
  });
</script>

<style>
  .case-study { padding-block: var(--space-12) var(--space-20); }
  .back-link {
    display: inline-flex; align-items: center; gap: var(--space-1);
    font-size: var(--text-sm); color: var(--clr-text-muted); text-decoration: none;
    margin-bottom: var(--space-10); transition: color var(--transition);
  }
  .back-link:hover { color: var(--clr-accent); text-decoration: none; }
  .case-header { padding-bottom: var(--space-10); border-bottom: 1px solid var(--clr-border); margin-bottom: var(--space-12); }
  .case-header__meta { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .case-title { font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl)); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: var(--clr-text); margin-bottom: var(--space-4); }
  .case-tagline { font-size: var(--text-lg); color: var(--clr-text-muted); line-height: 1.5; max-width: 560px; margin-bottom: var(--space-6); }
  .case-tools { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .meta-label { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--clr-text-subtle); white-space: nowrap; }
  .tools-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .case-sections { display: flex; flex-direction: column; }
  .case-section { padding-block: var(--space-8); border-bottom: 1px solid var(--clr-border); }
  .case-section:last-child { border-bottom: none; }
  .case-section__title { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--clr-accent); margin-bottom: var(--space-4); }
  .case-section__body { font-size: var(--text-base); color: var(--clr-text-muted); line-height: 1.7; max-width: 620px; }
  .outcome-section { background: var(--clr-accent-light); border-radius: var(--radius-lg); padding: var(--space-8); border: 1px solid rgba(47, 84, 160, 0.15); margin-block: var(--space-4); }
  [data-theme="dark"] .outcome-section { border-color: rgba(91, 130, 212, 0.2); }
  .case-footer { padding-top: var(--space-12); }
  .badge-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
</style>
